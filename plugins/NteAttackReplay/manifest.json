{
  "schemaVersion": 2,
  "id": "anomaly.builtin.nte-attack-replay",
  "name": "NTE Attack Replay",
  "description": "Always captures player-to-target CharacterOnDamaged events; when enabled, continuously replays the exact validated HTAbilitySystemComponent GameplayEffect call at the configured Game-tick interval. It never replays player input or rewrites target HP.",
  "author": "Anomaly",
  "license": "AGPL-3.0-only",
  "version": "1.9.4",
  "entry": "plugin.dll",
  "api": {
    "major": 1,
    "minMinor": 0,
    "maxMinor": 0
  },
  "games": [
    "nte"
  ],
  "builds": [
    "nte-*"
  ],
  "loadPhase": "game-ready",
  "services": [
    {
      "id": "anomaly.ui",
      "minVersion": 1
    },
    {
      "id": "anomaly.nte.combat",
      "minVersion": 1
    },
    {
      "id": "anomaly.nte.skills",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.ue5.framework",
      "minVersion": 1
    },
    {
      "id": "anomaly.nte.damage-replay",
      "minVersion": 1
    }
  ],
  "capabilities": [
    "ui",
    "nte-combat-read",
    "game-events",
    "nte-damage-replay"
  ]
}
