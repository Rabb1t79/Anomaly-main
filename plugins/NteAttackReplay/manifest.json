{
  "schemaVersion": 2,
  "id": "anomaly.builtin.nte-attack-replay",
  "name": "NTE Attack Replay",
  "description": "Automatically captures the first player-to-enemy damage event, then replays its correlated native game input and only counts newly observed matching damage events.",
  "author": "Anomaly",
  "license": "AGPL-3.0-only",
  "version": "1.4.0",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.ui", "minVersion": 1},
    {"id": "anomaly.nte.combat", "minVersion": 1},
    {"id": "anomaly.nte.skills", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.attack-input", "minVersion": 1}
  ],
  "capabilities": ["ui", "nte-combat-read", "nte-skills-read", "nte-attack-input", "game-events"]
}
