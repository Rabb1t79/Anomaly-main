{
  "schemaVersion": 2,
  "id": "anomaly.builtin.nte-attack-replay",
  "name": "NTE Attack Replay",
  "description": "Captures player-to-target CharacterOnDamaged events and reapplies the exact validated HTAbilitySystemComponent GameplayEffect call, at most once per Game tick, until the configured total hit count (including the original hit) is confirmed; it never replays player input or rewrites target HP.",
  "author": "Anomaly",
  "license": "AGPL-3.0-only",
  "version": "1.9.1",
  "entry": "plugin.dll",
  "api": {
    "major": 1,
    "minMinor": 0,
    "maxMinor": 0
  },
  "games": [
    "nte"
  ],
  "builds": [
    "nte-*"
  ],
  "loadPhase": "game-ready",
  "services": [
    {
      "id": "anomaly.ui",
      "minVersion": 1
    },
    {
      "id": "anomaly.nte.combat",
      "minVersion": 1
    },
    {
      "id": "anomaly.nte.skills",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.ue5.framework",
      "minVersion": 1
    },
    {
      "id": "anomaly.nte.damage-replay",
      "minVersion": 1
    }
  ],
  "capabilities": [
    "ui",
    "nte-combat-read",
    "game-events",
    "nte-damage-replay"
  ]
}
